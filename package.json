{
  "name": "devforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @devforge/db db:generate",
    "db:migrate": "pnpm --filter @devforge/db db:migrate",
    "db:seed": "pnpm --filter @devforge/db db:seed",
    "dev:api": "pnpm --filter @devforge/api dev",
    "dev:daemon": "pnpm --filter @devforge/daemon dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
